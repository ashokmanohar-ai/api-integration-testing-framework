pipeline {
  agent any
  options { timeout(time: 40, unit: 'MINUTES') }
  environment {
    POSTGRES_PASSWORD = credentials('acme-postgres-test-password')
  }
  stages {
    stage('Install') {
      steps {
        sh 'python3.12 -m venv .venv'
        sh '.venv/bin/pip install -e ".[dev,messaging,postgres]"'
      }
    }
    stage('Static quality') {
      parallel {
        stage('Ruff') { steps { sh '.venv/bin/ruff check . && .venv/bin/ruff format --check .' } }
        stage('MyPy') { steps { sh '.venv/bin/mypy .' } }
      }
    }
    stage('Integration environment') {
      steps {
        sh 'docker compose up -d --build'
        sh '.venv/bin/python scripts/wait_for_services.py'
      }
    }
    stage('Tests and gate') {
      steps {
        sh '.venv/bin/pytest -m "not docker" -n auto --junitxml=reports/junit.xml --html=reports/report.html --self-contained-html'
        sh '.venv/bin/quality-gate --junit reports/junit.xml'
      }
    }
  }
  post {
    always {
      junit 'reports/junit.xml'
      archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
      sh 'docker compose down -v || true'
    }
  }
}
